# ===========================================
# SUSOFT-SHOPIFY SYNC - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=susoft-shopify-sync
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-min-32-chars-here

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/susoft_shopify_sync
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (for Celery and distributed locks)
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TIMEOUT=10

# Encryption Key for API tokens (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Alert Settings
ALERT_QUEUE_TIMEOUT_MINUTES=5
ALERT_MAX_RETRIES=3

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#integrasjon-alerts

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Admin Portal
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
SUSOFT_RATE_LIMIT_PER_SECOND=5
SHOPIFY_RATE_LIMIT_PER_SECOND=2

# Optional: map Shopify shipping to a dedicated Susoft SKU (as order line)
SHOPIFY_SHIPPING_SKU=

# Health Check
HEALTH_CHECK_INTERVAL_SECONDS=60
