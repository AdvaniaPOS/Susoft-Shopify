# Production Environment Variables
# =================================
# Copy this file to .env and fill in the values

# Database password (change this!)
DB_PASSWORD=ChangeThisSecurePassword123!

# Encryption key for storing API credentials (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# JWT secret for admin authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# Admin API key for accessing the management API
ADMIN_API_KEY=

# Webhook secret for verifying Shopify webhooks (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=
